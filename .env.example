# Copy to .env and fill in from the Supabase dashboard.
# Keep real values out of git.
# SUPABASE_SECRET_KEY bypasses row level security. Use it on the backend only.

SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=
SUPABASE_JWT_SECRET=
ALLOWED_ORIGINS=http://localhost:5173

# Server only. Do not copy this into frontend/.env.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
